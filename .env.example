# =============================================================================
# Vehicle Maintenance AI Agent — Environment Configuration Template
# =============================================================================
# Copy this file to .env and replace placeholder values with your real configuration.
# Never commit the .env file to source control.

# -----------------------------------------------------------------------------
# Application Environment & Security
# -----------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=generate_a_secure_random_string_for_production
APP_HOST=0.0.0.0
APP_PORT=7860
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=vehicle_maintenance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# For local development outside Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:replace_with_a_strong_database_password@localhost:5432/vehicle_maintenance
# DATABASE_URL_SYNC=postgresql://postgres:replace_with_a_strong_database_password@localhost:5432/vehicle_maintenance

# -----------------------------------------------------------------------------
# Redis Configuration (In-Memory Cache)
# -----------------------------------------------------------------------------
# Inside Docker: redis://redis:6379/0
# Outside Docker: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Primary LLM Provider (Groq / OpenAI / Compatible)
# -----------------------------------------------------------------------------
PRIMARY_LLM_PROVIDER=groq
PRIMARY_LLM_MODEL=openai/gpt-oss-120b
PRIMARY_LLM_API_KEY=your_groq_api_key_here
PRIMARY_LLM_BASE_URL=https://api.groq.com/openai/v1

# -----------------------------------------------------------------------------
# Secondary LLM Provider (Failover Provider)
# -----------------------------------------------------------------------------
SECONDARY_LLM_PROVIDER=groq
SECONDARY_LLM_MODEL=llama-3.3-70b-versatile
SECONDARY_LLM_API_KEY=your_secondary_groq_api_key_here
SECONDARY_LLM_BASE_URL=https://api.groq.com/openai/v1

# -----------------------------------------------------------------------------
# Tertiary LLM Provider (Optional Additional Failover)
# -----------------------------------------------------------------------------
TERTIARY_LLM_PROVIDER=
TERTIARY_LLM_MODEL=
TERTIARY_LLM_API_KEY=
TERTIARY_LLM_BASE_URL=

# -----------------------------------------------------------------------------
# ML Model & Pipeline Paths (relative to app root)
# -----------------------------------------------------------------------------
ML_MODEL_PATH=models/maintenance_model.joblib
ML_PIPELINE_PATH=models/preprocessing_pipeline.joblib

# -----------------------------------------------------------------------------
# Frontend & URLs
# -----------------------------------------------------------------------------
# Set FRONTEND_URL to the public domain or EC2 public IP when deploying to AWS
FRONTEND_URL=http://localhost:3000
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# -----------------------------------------------------------------------------
# Google OAuth 2.0 (Optional — for user identity and emergency email delivery)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
SECURE_COOKIES=false
